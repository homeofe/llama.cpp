# Source this before a GPU run managed by the caller. No command is run here.
export GGML_MOE_HYBRID=1
export GGML_MOE_HYBRID_ADAPTIVE=1
export GGML_MOE_HYBRID_ADMIT=8
export GGML_MOE_HYBRID_MIB=2048
export GGML_SCHED_OVERLAP=1
export LLAMA_MOE_SHEXP_EARLY=1
export OMP_PLACES=cores
export OMP_PROC_BIND=close
# Optional: export GGML_MOE_HYBRID_PROFILE=/path/to/profile
# With no profile, unset GGML_MOE_HYBRID_PROFILE to start empty.
# For the baseline, override GGML_MOE_HYBRID=0.
# For frozen round 5, override GGML_MOE_HYBRID_ADAPTIVE=0 and supply a profile.
# For the pp4 cap ablation, override GGML_MOE_HYBRID_ADMIT=32.
